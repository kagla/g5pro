#### g5blade rewrite BEGIN #####
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 실제 파일·폴더는 그대로 (css/js/img/data …)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── .php 확장자 감추기 ─────────────────────────────
# /bbs/login → bbs/login.php, /shop/cart → shop/cart.php
# 반드시 아래 짧은주소 규칙보다 앞에 와야 한다.
# (안 그러면 /shop/cart 가 상품ID 'cart' 로, /free 가 게시판으로 먼저 잡힌다)
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.php -f
RewriteRule ^(.+?)/?$ $1.php [QSA,L]

# ── 그누보드 짧은주소 (cf_bbs_rewrite) ──────────────
RewriteRule ^shop/list-([0-9a-z]+)$  shop/list.php?ca_id=$1&rewrite=1  [QSA,L]
RewriteRule ^shop/type-([0-9a-z]+)$  shop/listtype.php?type=$1&rewrite=1  [QSA,L]
RewriteRule ^shop/([0-9a-zA-Z_\-]+)$  shop/item.php?it_id=$1&rewrite=1  [QSA,L]
RewriteRule ^shop/([^/]+)/$  shop/item.php?it_seo_title=$1&rewrite=1  [QSA,L]
RewriteRule ^content/([0-9a-zA-Z_]+)$ bbs/content.php?co_id=$1&rewrite=1 [QSA,L]
RewriteRule ^content/([^/]+)/$ bbs/content.php?co_seo_title=$1&rewrite=1 [QSA,L]
RewriteRule ^rss/([0-9a-zA-Z_]+)$ bbs/rss.php?bo_table=$1 [QSA,L]
# 게시판 — /board/{게시판}[/{글번호}|/write]. 루트(/)는 비워 둔다.
RewriteRule ^board/([0-9a-zA-Z_]+)$ bbs/board.php?bo_table=$1&rewrite=1 [QSA,L]
RewriteRule ^board/([0-9a-zA-Z_]+)/write$ bbs/write.php?bo_table=$1&rewrite=1 [QSA,L]
RewriteRule ^board/([0-9a-zA-Z_]+)/([0-9]+)$ bbs/board.php?bo_table=$1&wr_id=$2&rewrite=1 [QSA,L]
RewriteRule ^board/([0-9a-zA-Z_]+)/([^/]+)/$ bbs/board.php?bo_table=$1&wr_seo_title=$2&rewrite=1 [QSA,L]
</IfModule>
#### g5blade rewrite END #####
